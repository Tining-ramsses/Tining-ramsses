---
- name: Gather CPU, Memory, and Disk data from Dell iDRAC (via Redfish API)
  hosts: all
  gather_facts: false

  vars:
    output_dir: "/tmp/idrac_data"

  tasks:

    - name: Ensure output directory exists
      ansible.builtin.file:
        path: "{{ output_dir }}"
        state: directory
        mode: '0755'

    - name: Get full Redfish system info
      community.general.redfish_info:
        category: Systems
        command: GetSystem
        baseuri: "{{ inventory_hostname }}"
        username: "{{ idrac_user }}"
        password: "{{ idrac_password }}"
        validate_certs: false
      register: redfish_info

    - name: Debug full data (optional)
      debug:
        var: redfish_info
      when: debug | default(false)

    - name: Extract CPU, Memory and Disk data
      set_fact:
        cpu_count: "{{ redfish_info.redfish_facts.system.entries[0].ProcessorSummary.Count | default(0) }}"
        memory_gb: "{{ redfish_info.redfish_facts.system.entries[0].MemorySummary.TotalSystemMemoryGiB | default(0.0) }}"
        disks_gb: >-
          {{
            redfish_info.redfish_facts.system.entries[0].Storage | map(attribute='Drives')
            | flatten
            | map(attribute='CapacityBytes')
            | map('int')
            | sum / (1024**3)
            | round(2)
            if redfish_info.redfish_facts.system.entries[0].Storage is defined else 0
          }}

    - name: Save formatted data to JSON
      copy:
        dest: "{{ output_dir }}/{{ inventory_hostname }}.json"
        content: |
          {
            "host": "{{ inventory_hostname }}",
            "cpu_cores": {{ cpu_count }},
            "memory_gb": {{ memory_gb }},
            "disks_gb_total": {{ disks_gb }}
          }

    - name: Display summary
      debug:
        msg:
          - "Host: {{ inventory_hostname }}"
          - "CPU cores: {{ cpu_count }}"
          - "Memory (GB): {{ memory_gb }}"
          - "Disk total (GB): {{ disks_gb }}"
