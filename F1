---
- name: Gather CPU, Memory, and Disk data from Dell iDRAC
  hosts: all
  connection: local
  gather_facts: no
  collections:
    - dellemc.openmanage
  vars:
    output_dir: "/var/ansible/facts/idrac_facts"

  tasks:
    - name: Ensure output directory exists
      ansible.builtin.file:
        path: "{{ output_dir }}"
        state: directory
        mode: '0755'

    - name: Get system inventory from iDRAC
      dellemc.openmanage.idrac_system_info:
        idrac_ip: "{{ ansible_host }}"
        idrac_user: "{{ idrac_user }}"
        idrac_password: "{{ idrac_password }}"
        validate_certs: false
      register: idrac_info

    - name: Extract and format hardware data
      ansible.builtin.set_fact:
        system_data:
          hostname: "{{ inventory_hostname }}"
          cpu_cores: "{{ idrac_info.system_info.Processors | map(attribute='TotalNumberOfCores') | list | sum | default(0) }}"
          memory_gb: "{{ idrac_info.system_info.Memory | map(attribute='SizeMB') | list | sum | float / 1024 | round(2) }}"
          disk_gb: "{{ idrac_info.system_info.Storage | map(attribute='CapacityGiB') | list | sum | round(2) }}"

    - name: Save system data to JSON
      ansible.builtin.copy:
        dest: "{{ output_dir }}/{{ inventory_hostname }}.json"
        content: "{{ system_data | to_nice_json }}"
        mode: '0644'
