---
- name: Gather CPU, Memory, and Disk data from Dell iDRAC
  hosts: all
  connection: local
  gather_facts: no
  collections:
    - dellemc.openmanage
  vars:
    output_dir: "/var/ansible/facts/idrac_facts"

  tasks:
    - name: Ensure output directory exists
      ansible.builtin.file:
        path: "{{ output_dir }}"
        state: directory
        mode: '0755'

    - name: Get system inventory from iDRAC
      dellemc.openmanage.idrac_system_info:
        idrac_ip: "{{ ansible_host }}"
        idrac_user: "{{ idrac_user }}"
        idrac_password: "{{ idrac_password }}"
        validate_certs: false
      register: idrac_info

    - name: Debug iDRAC info structure
      ansible.builtin.debug:
        var: idrac_info
