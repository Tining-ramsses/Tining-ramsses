---
- name: Gather full system info from Dell iDRAC via Redfish API
  hosts: all
  gather_facts: no
  vars:
    idrac_ip: "{{ inventory_hostname }}"
    idrac_user: root
    idrac_password: "VotreMotDePasse"
    output_file: "/tmp/redfish_system_info.json"

  tasks:
    - name: Get Redfish System resource
      community.general.redfish_info:
        category: Systems
        command: GetSystem
        baseuri: "https://{{ idrac_ip }}"
        username: "{{ idrac_user }}"
        password: "{{ idrac_password }}"
        timeout: 30
      register: system_info

    - name: Show system data (raw JSON)
      debug:
        var: system_info.redfish_facts.System

    - name: Extract summarized hardware info
      set_fact:
        hardware_summary:
          Model: "{{ system_info.redfish_facts.System[0].Model | default('N/A') }}"
          Manufacturer: "{{ system_info.redfish_facts.System[0].Manufacturer | default('N/A') }}"
          SerialNumber: "{{ system_info.redfish_facts.System[0].SerialNumber | default('N/A') }}"
          BIOSVersion: "{{ system_info.redfish_facts.System[0].BiosVersion | default('N/A') }}"
          CPU_Model: "{{ system_info.redfish_facts.System[0].ProcessorSummary.Model | default('N/A') }}"
          CPU_Count: "{{ system_info.redfish_facts.System[0].ProcessorSummary.Count | default('N/A') }}"
          Memory_Installed_MB: "{{ system_info.redfish_facts.System[0].MemorySummary.TotalSystemMemoryGiB | float * 1024 | int }}"
          PowerState: "{{ system_info.redfish_facts.System[0].PowerState | default('N/A') }}"

    - name: Display summarized hardware info
      debug:
        var: hardware_summary

    - name: Save full output to file
      copy:
        content: "{{ system_info | to_nice_json }}"
        dest: "{{ output_file }}"
