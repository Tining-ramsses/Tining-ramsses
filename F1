---
- name: Gather CPU, Memory, and Disk data from Dell iDRAC using Redfish
  hosts: all
  gather_facts: false

  vars:
    output_dir: "/tmp/idrac_data"

  tasks:
    - name: Ensure output directory exists
      ansible.builtin.file:
        path: "{{ output_dir }}"
        state: directory
        mode: '0755'

    - name: Get detailed system info from iDRAC via Redfish
      dellemc.openmanage.redfish_info:
        baseuri: "{{ inventory_hostname }}"
        username: "{{ idrac_user }}"
        password: "{{ idrac_password }}"
        category: Systems
        command: GetSystemInventory
        validate_certs: false
      register: redfish_info

    - name: Show raw Redfish info (for debugging only)
      debug:
        var: redfish_info
      when: debug | default(false)

    - name: Parse CPU, Memory, and Disk data
      set_fact:
        cpu_count: "{{ redfish_info.systems[0].ProcessorSummary.Count | default(0) }}"
        memory_gb: "{{ redfish_info.systems[0].MemorySummary.TotalSystemMemoryGiB | default(0.0) | float }}"
        disks_gb: >-
          {{
            (
              redfish_info.systems[0].Storage[0].Drives
              | map(attribute='CapacityBytes')
              | map('int')
              | sum / (1024 ** 3)
            ) | round(2)
            if redfish_info.systems[0].Storage is defined and redfish_info.systems[0].Storage[0].Drives is defined
            else 0
          }}

    - name: Save formatted data to file
      ansible.builtin.copy:
        dest: "{{ output_dir }}/{{ inventory_hostname }}.json"
        content: |
          {
            "host": "{{ inventory_hostname }}",
            "cpu_cores": {{ cpu_count }},
            "memory_gb": {{ memory_gb }},
            "disks_gb_total": {{ disks_gb }}
          }

    - name: Display summary
      ansible.builtin.debug:
        msg:
          - "Host: {{ inventory_hostname }}"
          - "CPU Cores: {{ cpu_count }}"
          - "Memory (GB): {{ memory_gb }}"
          - "Disk Total (GB): {{ disks_gb }}"
