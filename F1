---
- name: Gather hardware info from Dell iDRAC via Redfish API
  hosts: all
  gather_facts: false

  vars:
    output_dir: "/tmp/idrac_data"

  tasks:
    - name: Ensure output directory exists
      ansible.builtin.file:
        path: "{{ output_dir }}"
        state: directory
        mode: '0755'

    - name: Get Redfish Chassis Inventory (CPU, Memory, Disks)
      community.general.redfish_info:
        category: Systems
        command: GetChassisInventory
        baseuri: "{{ inventory_hostname }}"
        username: "{{ idrac_user }}"
        password: "{{ idrac_password }}"
      register: redfish_data

    - name: Parse system data
      set_fact:
        cpu_count: "{{ redfish_data.redfish_info.Processors | length if redfish_data.redfish_info.Processors is defined else 0 }}"
        memory_gb: "{{ (redfish_data.redfish_info.MemorySummary.TotalSystemMemoryGiB | default(0)) | int }}"
        disks_gb: "{{ (redfish_data.redfish_info.Storage | map(attribute='Drives') | flatten | map(attribute='CapacityBytes') | map('int') | sum / (1024 ** 3)) | round(2) if redfish_data.redfish_info.Storage is defined else 0 }}"

    - name: Save formatted data to file
      ansible.builtin.copy:
        dest: "{{ output_dir }}/{{ inventory_hostname }}.json"
        content: |
          {
            "host": "{{ inventory_hostname }}",
            "cpu_cores": {{ cpu_count }},
            "memory_gb": {{ memory_gb }},
            "disks_gb_total": {{ disks_gb }}
          }

    - name: Display summary
      debug:
        msg:
          - "Host: {{ inventory_hostname }}"
          - "CPU cores: {{ cpu_count }}"
          - "Memory (GB): {{ memory_gb }}"
          - "Disk total (GB): {{ disks_gb }}"
